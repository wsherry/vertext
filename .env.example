# OpenAI powers speaker report synthesis. TrueForge also needs an OpenAI provider
# configured in its own Settings → Models page.
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-4.1-mini

# TrueForge server (local server requires Node 22.14+ to run).
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=
TRUEFORGE_MODEL=openai/gpt-4.1-mini

# Bright Data Fetch API. Set the dataset ID for the Fetch API scraper available
# in your Bright Data account; the app never scrapes until a speaker requests it.
BRIGHTDATA_API_KEY=
BRIGHTDATA_FETCH_DATASET_ID=

# FalkorDB: run locally with docker compose or point at your managed instance.
FALKORDB_URL=falkor://localhost:6379
FALKORDB_GRAPH=conference_talk_companion

# Privacy threshold for report details. Below this count, the report is suppressed.
REPORT_MIN_COHORT=5
PORT=3001
